# 🚫 Fichiers à ignorer

# Environnement
.env
.env.local
.env.*.local

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Données de sortie (générées par les agents/skills)
data/outputs/
!data/outputs/.gitkeep

# Logs
*.log
logs/

# Fichiers temporaires
tmp/
temp/
*.tmp

# Clés API et secrets
*.key
*.pem
*.json
!configs/*.yaml
!configs/*.json

# Données sensibles
data/inputs/*.secret
data/datasets/*.private

# Fichiers de test générés
tests/fixtures/.cache/

# Dependencies
node_modules/
package-lock.json

# Jupyter
.ipynb_checkpoints/
*.ipynb