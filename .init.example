# 🔑 Variables d'environnement pour AI Agents Hub
# Copier ce fichier en `.env` et remplir les valeurs.

# --- Clés API pour les LLM ---
MISTRAL_API_KEY=""
CLAUDE_API_KEY=""
OPENAI_API_KEY=""

# --- Clés API pour les outils web ---
SERPAPI_KEY=""          # https://serpapi.com/
TAVILY_API_KEY=""       # https://tavily.com/

# --- Clés API pour l'analyse de code ---
GITHUB_TOKEN=""         # Pour accéder aux repos privés
SONARQUBE_TOKEN=""      # Pour l'analyse de qualité de code

# --- Configuration des agents ---
# Modèle par défaut pour Mistral
MISTRAL_MODEL="mistral-medium-latest"
MISTRAL_TEMPERATURE=0.7
MISTRAL_MAX_TOKENS=4096

# Modèle par défaut pour Claude
CLAUDE_MODEL="claude-3-sonnet-20240229"
CLAUDE_TEMPERATURE=0.7
CLAUDE_MAX_TOKENS=4096

# --- Chemins ---
# Dossier de sortie par défaut pour les résultats
default_output_dir="./data/outputs"

# --- Logging ---
LOG_LEVEL="INFO"         # DEBUG, INFO, WARNING, ERROR
LOG_FILE="./logs/agents.log"

# --- Sécurité ---
# Désactiver l'exécution de code généré par les LLM (recommandé)
ALLOW_CODE_EXECUTION=false

# Liste des domaines autorisés pour le scraping web (séparés par des virgules)
ALLOWED_SCRAPE_DOMAINS="example.com,github.com"